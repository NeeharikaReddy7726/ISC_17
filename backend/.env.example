# Example environment configuration for QR Shield Backend
# Copy this file to '.env' and set strong, unique secrets

JWT_SECRET_KEY=replace_with_a_64_char_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 256-bit (32-byte) AES key represented as 64 hex characters
AES_SECRET_KEY=replace_with_a_64_char_random_hex_string
